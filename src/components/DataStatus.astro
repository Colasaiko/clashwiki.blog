---
interface Props {
  last_checked?: {
    price: string | Date;
    network: string | Date;
    streaming: string | Date;
    ai_support: string | Date;
  };
  updatedDate?: string | Date;
}

const { last_checked, updatedDate } = Astro.props;

if (!last_checked) return null;

const formatDate = (date: any) => {
  if (!date) return 'N/A';
  if (typeof date === 'string') return date.split('T')[0];
  return date.toISOString().split('T')[0];
};

const checks = [
  { label: '入网价格与优惠检查', value: formatDate(last_checked.price) },
  { label: '晚高峰测速与线路探针', value: formatDate(last_checked.network) },
  { label: '流媒体(Netflix/Disney)解锁', value: formatDate(last_checked.streaming) },
  { label: 'AI (ChatGPT/Claude)纯净度', value: formatDate(last_checked.ai_support) },
];
---

<div class="my-8 overflow-hidden rounded-xl bg-slate-900 border border-slate-700 shadow-2xl font-mono text-sm not-prose">
  {/* Header */}
  <div class="flex items-center justify-between bg-slate-800/50 px-4 py-3 border-b border-slate-700">
    <div class="flex items-center space-x-2">
      <div class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></div>
      <h3 class="text-emerald-400 font-bold tracking-wider m-0">DATA STATUS // 实测数据监控台</h3>
    </div>
    <div class="text-slate-400 text-xs">
      数据版本: {formatDate(updatedDate)}
    </div>
  </div>

  {/* Body */}
  <div class="p-4 grid grid-cols-1 md:grid-cols-2 gap-4">
    {checks.map(check => (
      <div class="flex flex-col bg-slate-800/40 p-3 rounded-lg border border-slate-700/50">
        <span class="text-slate-400 text-xs tracking-wider mb-1">{check.label}</span>
        <div class="flex items-center justify-between">
          <span class="text-slate-200 font-medium">{check.value}</span>
          <span class="text-emerald-400 text-xs flex items-center">
            <svg class="w-3 h-3 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
            PASSED
          </span>
        </div>
      </div>
    ))}
  </div>
</div>
