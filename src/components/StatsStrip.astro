---
interface Stat {
  label: string;
  value: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---
<div class="bg-white/50 backdrop-blur-sm border border-slate-200 rounded-2xl p-8 mt-4 mb-12 shadow-sm">
  <div class="grid grid-cols-2 md:grid-cols-4 gap-8 divide-x divide-slate-200">
    {stats.map((stat, i) => (
      <div class={`text-center ${i % 2 !== 0 && i !== 3 ? 'border-none md:border-solid md:border-l' : ''} ${i === 2 ? 'border-none md:border-solid md:border-l' : ''}`}>
        <div class="text-3xl md:text-4xl font-bold text-slate-900  mb-2 font-heading">{stat.value}</div>
        <div class="text-sm font-medium text-slate-500  uppercase tracking-wider">{stat.label}</div>
      </div>
    ))}
  </div>
</div>
