---
---
<div class="fixed inset-0 z-0 overflow-hidden pointer-events-none bg-slate-900">
  <canvas id="dotGrid" class="absolute top-0 left-0 w-full h-full opacity-60"></canvas>
  <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-white/80"></div>
</div>

<script>
  function initDotGrid() {
    const canvas = document.getElementById('dotGrid') as HTMLCanvasElement;
    if (!canvas) return;
    
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    let width: number, height: number;
    const spacing = 40;
    const baseRadius = 1.5; // 3px diameter
    const maxRadius = 4.5; // Larger for clear visibility
    
    interface Dot {
      x: number;
      y: number;
      baseRadius: number;
      pulse: number;
      pulsing: boolean;
      pulseDir: number;
      pulseSpeed: number;
      delay: number;
    }
    
    let dots: Dot[] = [];
    
    function resize() {
      // Add extra width/height to compensate for the perspective scale/tilt
      width = window.innerWidth * 1.5;
      height = window.innerHeight * 1.5;
      canvas.width = width;
      canvas.height = height;
      initDots();
    }
    
    function initDots() {
      dots = [];
      const cols = Math.ceil(width / spacing);
      const rows = Math.ceil(height / spacing);
      
      for (let i = 0; i <= cols; i++) {
        for (let j = 0; j <= rows; j++) {
          dots.push({
            x: i * spacing,
            y: j * spacing,
            baseRadius: baseRadius,
            pulse: 0,
            pulsing: false,
            pulseDir: 1,
            pulseSpeed: 0,
            delay: Math.random() * 8000 // random initial delay
          });
        }
      }
    }
    
    // Apply CSS perspective tilt to the canvas to create depth
    canvas.style.transform = "perspective(1000px) rotateX(30deg) scale(1.5) translateY(-1< 1%)";
    canvas.style.transformOrigin = "top center";

    let lastTime = performance.now();
    let animationFrameId: number;
    
    function animate(time: number) {
      const dt = time - lastTime;
      lastTime = time;
      
      const isDark = false;
      const baseColor = 'rgba(0, 0, 0, 0.2)';
      const pulseColor = 'rgba(16, 185, 129, '; // emerald-500
      
      ctx.clearRect(0, 0, width, height);
      
      for (let i = 0; i < dots.length; i++) {
        const dot = dots[i];
        
        if (!dot.pulsing) {
          dot.delay -= dt;
          if (dot.delay <= 0) {
            dot.pulsing = true;
            dot.pulseDir = 1;
            dot.pulseSpeed = 0.0005 + Math.random() * 0.001; // Slower, more elegant pulse
          }
        } else {
          dot.pulse += dot.pulseSpeed * dot.pulseDir * dt;
          if (dot.pulse >= 1) {
            dot.pulse = 1;
            dot.pulseDir = -1;
          } else if (dot.pulse <= 0) {
            dot.pulse = 0;
            dot.pulsing = false;
            dot.delay = 3000 + Math.random() * 15000;
          }
        }
        
        const easePulse = Math.sin(dot.pulse * (Math.PI / 2));
        const currentRadius = dot.baseRadius + (maxRadius - dot.baseRadius) * easePulse;
        
        ctx.beginPath();
        ctx.arc(dot.x, dot.y, currentRadius, 0, Math.PI * 2);
        
        if (dot.pulse > 0) {
          const alpha = 0.3 + easePulse * 0.7;
          ctx.fillStyle = pulseColor + alpha + ')';
          ctx.shadowBlur = 15 * easePulse;
          ctx.shadowColor = 'rgba(16, 185, 129, 0.6)';
        } else {
          ctx.fillStyle = baseColor;
          ctx.shadowBlur = 0;
        }
        
        ctx.fill();
      }
      
      animationFrameId = requestAnimationFrame(animate);
    }
    
    window.addEventListener('resize', resize);
    resize();
    animationFrameId = requestAnimationFrame(animate);
    
    // Cleanup on component unmount (for Astro view transitions)
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animationFrameId);
      window.removeEventListener('resize', resize);
    }, { once: true });
  }

  // Initialize
  document.addEventListener('DOMContentLoaded', initDotGrid);
  document.addEventListener('astro:page-load', initDotGrid);
</script>
