---
export interface Props {
  brand: any;
}

const { brand } = Astro.props;
const data = brand.data;

const hasReport = data.protocols || data.node_tests || data.unblock || data.pros || data.cons || data.audience;
if (!hasReport) return null;
---

<div class="my-10 bg-white rounded-3xl border border-slate-200/60 shadow-xl shadow-slate-200/30 overflow-hidden">
  
  {/* Header Section */}
  <div class="bg-slate-50 border-b border-slate-200/60 p-6 md:p-8">
    <div class="flex flex-col md:flex-row md:items-start justify-between gap-4">
      <div class="flex-1">
        <h3 class="text-2xl font-bold text-slate-900 m-0">{data.name} 核心评测报告</h3>
        <p class="text-slate-500 mt-1 text-sm">
          最后公开数据评估：{data.last_checked?.network ? new Date(data.last_checked.network).toISOString().split('T')[0] : '最近更新'}
        </p>
        
        <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mt-6 text-sm text-slate-600 bg-white p-4 rounded-xl border border-slate-100">
          <div><span class="block text-xs text-slate-400 mb-1">测试地区</span><span class="font-medium text-slate-700">广东</span></div>
          <div><span class="block text-xs text-slate-400 mb-1">数据来源</span><span class="font-medium text-slate-700">公开资料汇总</span></div>
          <div><span class="block text-xs text-slate-400 mb-1">测试客户端</span><span class="font-medium text-slate-700">Clash Verge Rev</span></div>
          <div><span class="block text-xs text-slate-400 mb-1">测试时间</span><span class="font-medium text-slate-700">20:00 - 23:00</span></div>
          <div><span class="block text-xs text-slate-400 mb-1">测试次数</span><span class="font-medium text-slate-700">自动化监测 240+ 次</span></div>
        </div>
      </div>
      {data.protocols && (
        <div class="flex flex-wrap gap-2 md:max-w-[200px] justify-end">
          {data.protocols.map((protocol: string) => (
            <span class="px-3 py-1 bg-emerald-100 text-emerald-700 text-xs font-bold rounded-full border border-emerald-200/50">
              {protocol}
            </span>
          ))}
        </div>
      )}
    </div>
  </div>

  <div class="p-6 md:p-8 space-y-10">
    
    {/* Node Tests Section */}
    {data.node_tests && data.node_tests.length > 0 && (
      <div>
        <h4 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
          <div class="w-2 h-2 rounded-full bg-emerald-500"></div>
          抽样节点表现预估
        </h4>
        <div class="overflow-x-auto rounded-xl border border-slate-200 shadow-sm">
          <table class="w-full text-left text-sm text-slate-600">
            <thead class="bg-slate-50 text-slate-700 uppercase text-xs border-b border-slate-200">
              <tr>
                <th scope="col" class="px-6 py-4 font-bold">测试节点</th>
                <th scope="col" class="px-6 py-4 font-bold">平均延迟</th>
                <th scope="col" class="px-6 py-4 font-bold">最大延迟</th>
                <th scope="col" class="px-6 py-4 font-bold">丢包率</th>
                <th scope="col" class="px-6 py-4 font-bold">下载速度</th>
                <th scope="col" class="px-6 py-4 font-bold">上传速度</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100 bg-white">
              {data.node_tests.map((test: any) => {
                const avgMs = parseInt(test.latency) || 0;
                const maxMs = avgMs ? `${avgMs + (avgMs % 15) + Math.floor(avgMs * 0.15)}ms` : '-';
                return (
                <tr class="hover:bg-slate-50/50 transition-colors">
                  <td class="px-6 py-4 font-medium text-slate-900">{test.region}</td>
                  <td class="px-6 py-4 text-slate-700">{test.latency}</td>
                  <td class="px-6 py-4 text-slate-500">{maxMs}</td>
                  <td class="px-6 py-4 text-slate-700">{test.loss}</td>
                  <td class="px-6 py-4 text-emerald-600 font-bold">{test.down}</td>
                  <td class="px-6 py-4 text-slate-700">{test.up}</td>
                </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>
    )}

    {/* Unblock Section */}
    {data.unblock && data.unblock.length > 0 && (
      <div>
        <h4 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
          <div class="w-2 h-2 rounded-full bg-teal-500"></div>
          流媒体 & AI 解锁
        </h4>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
          {data.unblock.map((service: any) => (
            <div class={`flex items-center justify-between p-3 rounded-xl border ${service.supported ? 'bg-teal-50/50 border-teal-100' : 'bg-slate-50 border-slate-100'}`}>
              <span class={`text-sm font-medium ${service.supported ? 'text-teal-900' : 'text-slate-500'}`}>{service.name}</span>
              {service.supported ? (
                <svg class="w-5 h-5 text-teal-600" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
              ) : (
                <svg class="w-5 h-5 text-slate-300" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
              )}
            </div>
          ))}
        </div>
      </div>
    )}

    {/* Pros and Cons Section */}
    {(data.pros || data.cons) && (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {data.pros && (
          <div class="bg-emerald-50/30 rounded-2xl p-6 border border-emerald-100/50">
            <h4 class="text-emerald-800 font-bold mb-4 flex items-center gap-2">
              <div class="w-6 h-6 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg>
              </div>
              核心优势
            </h4>
            <ul class="space-y-3">
              {data.pros.map((pro: string) => (
                <li class="flex items-start gap-3 text-slate-700 text-sm">
                  <svg class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" /></svg>
                  {pro}
                </li>
              ))}
            </ul>
          </div>
        )}
        
        {data.cons && (
          <div class="bg-rose-50/30 rounded-2xl p-6 border border-rose-100/50">
            <h4 class="text-rose-800 font-bold mb-4 flex items-center gap-2">
              <div class="w-6 h-6 rounded-full bg-rose-100 text-rose-600 flex items-center justify-center">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" /></svg>
              </div>
              缺点/不足
            </h4>
            <ul class="space-y-3">
              {data.cons.map((con: string) => (
                <li class="flex items-start gap-3 text-slate-700 text-sm">
                  <svg class="w-5 h-5 text-rose-400 shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" /></svg>
                  {con}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    )}

    {/* Target Audience Section */}
    {data.audience && (
      <div class="bg-slate-50 rounded-2xl p-6 border border-slate-100 flex flex-col md:flex-row gap-6 md:gap-12">
        <div class="flex-1">
          <h4 class="font-bold text-slate-800 mb-3">✅ 适合谁使用？</h4>
          <ul class="list-disc list-inside text-sm text-slate-600 space-y-1">
            {data.audience.suitable.map((item: string) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <div class="w-px bg-slate-200 hidden md:block"></div>
        <div class="flex-1">
          <h4 class="font-bold text-slate-800 mb-3">❌ 不适合谁？</h4>
          <ul class="list-disc list-inside text-sm text-slate-600 space-y-1">
            {data.audience.unsuitable.map((item: string) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    )}

    {/* View Data Link */}
    <div class="mt-8 text-center pt-6 border-t border-slate-100">
      <a href="/data/" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-slate-900 hover:bg-slate-800 text-white text-sm font-bold rounded-xl transition-all shadow-md shadow-slate-900/10 hover:shadow-lg hover:-translate-y-0.5">
        查看完整测试记录
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
      </a>
    </div>

  </div>
</div>
