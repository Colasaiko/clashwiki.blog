---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  asH1?: boolean;
}

const { title, subtitle, align = 'center', asH1 = false } = Astro.props;
---
<div class={`mb-12 ${align === 'center' ? 'text-center' : 'text-left'}`}>
  {asH1 ? (
    <h1 class="text-3xl md:text-4xl font-bold font-heading text-slate-100 mb-4">
      {title}
    </h1>
  ) : (
    <h2 class="text-3xl md:text-4xl font-bold font-heading text-slate-100 mb-4">
      {title}
    </h2>
  )}
  {subtitle && (
    <p class="text-slate-400  max-w-2xl text-lg md:text-xl leading-relaxed mx-auto">
      {subtitle}
    </p>
  )}
</div>
