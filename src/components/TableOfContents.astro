---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

// Filter to h2 only as requested
const tocHeadings = headings.filter(h => h.depth === 2);
const hasToc = tocHeadings.length >= 2;
---

{hasToc && (
  <nav class="sticky top-[80px] z-40 bg-slate-900/95 backdrop-blur-md border border-slate-700/60 shadow-lg shadow-slate-900/50 rounded-xl p-3 mb-10 transition-all">
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-slate-200 font-bold text-sm shrink-0 flex items-center gap-1">
        <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" /></svg>
        本文目录：
      </span>
      {tocHeadings.map((heading) => (
        <a 
          href={`#${heading.slug}`} 
          class="text-xs md:text-sm font-medium px-3 py-1.5 bg-slate-800 text-slate-300 hover:bg-emerald-500 hover:text-white rounded-lg transition-colors whitespace-nowrap border border-slate-700 hover:border-emerald-500"
        >
          {heading.text}
        </a>
      ))}
    </div>
  </nav>
)}
