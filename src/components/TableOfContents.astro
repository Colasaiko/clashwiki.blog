---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

const { headings } = Astro.props;

// Filter to h2 and h3 to avoid too much noise, and only show TOC if there are at least 2 headings
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);
const hasToc = tocHeadings.length >= 2;
---

{hasToc && (
  <nav class="toc-container bg-slate-50 border border-slate-100 rounded-2xl p-6 mb-10 shadow-sm">
    <h2 class="text-xl font-bold text-slate-800 mb-4 flex items-center gap-2 mt-0">
      <span class="text-2xl">📑</span> 本文目录
    </h2>
    <ul class="space-y-2 list-none pl-0 m-0">
      {tocHeadings.map((heading) => (
        <li class={`leading-tight ${heading.depth === 3 ? 'ml-6 text-sm' : 'text-base font-medium'}`}>
          <a 
            href={`#${heading.slug}`} 
            class="text-slate-600 hover:text-emerald-600 transition-colors no-underline block py-1"
          >
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}
