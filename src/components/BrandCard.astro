---
interface Props {
  name: string;
  description: string;
  url: string;
  tags?: string[];
  image?: string;
  buyUrl?: string;
  scores?: {
    stability: number;
    peak_speed: number;
    latency: number;
    packet_loss: number;
    streaming: number;
    ai_support: number;
    price: number;
  };
}

const { name, description, url, tags = [], image, buyUrl, scores } = Astro.props;

let weightedScore: string | null = null;
if (scores) {
  weightedScore = (
    (scores.stability * 0.25) +
    (scores.peak_speed * 0.20) +
    (scores.latency * 0.15) +
    (scores.packet_loss * 0.15) +
    (scores.streaming * 0.10) +
    (scores.ai_support * 0.05) +
    (scores.price * 0.10)
  ).toFixed(1);
}
---
<div class="brand-item tilt-card-3d group block glass-panel p-6 h-full flex flex-col relative transition-all duration-300 hover:shadow-[0_20px_40px_-15px_rgba(16,185,129,0.2)] hover:-translate-y-1 z-10" style="transform-style: preserve-3d;" data-tags={tags.join(',')} data-score={weightedScore || '0'} data-price={scores?.price || '0'}>
  {weightedScore && (
    <div class="absolute -top-3 -right-3 z-30 bg-gradient-to-br from-emerald-500 to-teal-600 text-white font-bold px-3 py-1.5 rounded-xl shadow-lg shadow-emerald-500/30 flex items-center gap-1 border-2 border-white transform rotate-3">
      <svg class="w-3.5 h-3.5 text-amber-300" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path></svg>
      <span class="text-sm tracking-wide">{weightedScore}</span>
    </div>
  )}
  <a href={url} class="absolute inset-0 z-20" aria-label={name}></a>
  {image && (
    <div class="relative w-full h-48 overflow-hidden rounded-t-2xl">
      <img src={image} alt={name} width="600" height="400" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
      <div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 to-transparent"></div>
    </div>
  )}
  <div class="relative z-10 flex-1 flex flex-col pointer-events-none">
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-2xl font-bold font-heading text-slate-900 group-hover:text-emerald-500 transition-colors">
      {name}
    </h3>
    <div class="w-10 h-10 rounded-full bg-slate-100 flex items-center justify-center text-slate-400 group-hover:bg-emerald-100 group-hover:text-emerald-500 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" clip-rule="evenodd" />
      </svg>
    </div>
  </div>
  
  <p class="text-slate-500 text-sm mb-6 line-clamp-2 h-10">
    {description}
  </p>
  
  <div class="flex items-center justify-between mt-auto pt-4 gap-2">
    <div class="flex flex-wrap gap-2 flex-1">
      {tags.slice(0, 3).map(tag => (
        <span class="px-2.5 py-1 text-xs font-medium bg-white/60 backdrop-blur-sm border border-white/50 text-slate-700 rounded-md shadow-sm">
          {tag}
        </span>
      ))}
      {tags.length > 3 && (
        <span class="px-2.5 py-1 text-xs font-medium bg-white/60 backdrop-blur-sm border border-white/50 text-slate-500 rounded-md shadow-sm">
          +{tags.length - 3}
        </span>
      )}
    </div>
    <a href={buyUrl || url} rel={buyUrl?.startsWith('/go/') ? "nofollow" : undefined} class="relative z-30 pointer-events-auto inline-flex shrink-0 items-center justify-center px-4 py-2 bg-gradient-to-r from-emerald-500 to-teal-500 text-white text-sm font-bold rounded-xl shadow-lg shadow-emerald-500/30 transition-all duration-300 group-hover:shadow-emerald-500/50 hover:-translate-y-0.5 hover:scale-105">
      {buyUrl?.startsWith('/go/') ? '服务入口 (推广)' : '立即购买'}
    </a>
  </div>
  </div>
</div>
