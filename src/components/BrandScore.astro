---
interface Props {
  scores: {
    stability: number; // 30%
    latency: number; // 20%
    speed: number; // 20%
    price: number; // 15%
    client_support: number; // 10%
    service: number; // 5%
  };
}

const { scores } = Astro.props;

// Calculate weighted score on a 5.0 scale
const weightedScore = (
  (scores.stability * 0.30) +
  (scores.latency * 0.20) +
  (scores.speed * 0.20) +
  (scores.price * 0.15) +
  (scores.client_support * 0.10) +
  (scores.service * 0.05)
).toFixed(1);

const dimensions = [
  { label: '稳定性', score: scores.stability.toFixed(1), weight: '30%' },
  { label: '延迟', score: scores.latency.toFixed(1), weight: '20%' },
  { label: '速度', score: scores.speed.toFixed(1), weight: '20%' },
  { label: '价格', score: scores.price.toFixed(1), weight: '15%' },
  { label: '客户端支持', score: scores.client_support.toFixed(1), weight: '10%' },
  { label: '售后/服务', score: scores.service.toFixed(1), weight: '5%' },
];
---

<div class="bg-white/90 backdrop-blur-xl p-6 md:p-10 rounded-3xl border border-slate-200 shadow-xl mb-12 flex flex-col md:flex-row gap-8 items-stretch relative overflow-hidden">
  <div class="absolute inset-0 bg-gradient-to-br from-emerald-50 to-teal-50/50 pointer-events-none"></div>
  
  {/* Score Callout */}
  <div class="flex-shrink-0 flex flex-col items-center justify-center p-8 bg-gradient-to-br from-emerald-600 to-teal-700 rounded-2xl text-white shadow-lg shadow-emerald-500/20 w-full md:w-56 relative z-10">
    <div class="text-sm font-medium mb-3 text-emerald-100 tracking-wider">综合加权评分</div>
    <div class="flex items-baseline gap-1 relative">
      <span class="text-6xl font-black font-heading tracking-tighter text-transparent bg-clip-text bg-gradient-to-br from-white to-emerald-100">{weightedScore}</span>
      <span class="text-2xl font-bold text-emerald-200/80">/ 5</span>
    </div>
    <div class="mt-5 flex text-amber-300 gap-1">
      {Array.from({ length: 5 }).map((_, i) => (
        <svg class={`w-5 h-5 ${i < Math.round(Number(weightedScore)) ? 'text-amber-400 drop-shadow' : 'text-emerald-800'}`} fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
        </svg>
      ))}
    </div>
  </div>
  
  {/* Transparency Breakdown */}
  <div class="flex-grow flex flex-col justify-center relative z-10">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-lg font-bold text-slate-800 m-0">透明评分矩阵</h3>
      <span class="text-xs font-medium px-2.5 py-1 bg-emerald-100 text-emerald-700 rounded-full border border-emerald-200">加权计算公式公示</span>
    </div>
    
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-4">
      {dimensions.map(dim => (
        <div class="flex items-center justify-between group">
          <div class="flex items-center gap-2">
            <span class="text-sm font-medium text-slate-700">{dim.label}</span>
            <span class="text-[10px] px-1.5 py-0.5 bg-slate-100 text-slate-500 rounded font-mono border border-slate-200">{dim.weight}</span>
          </div>
          <div class="flex items-center gap-3 w-1/2">
            <div class="h-1.5 flex-grow bg-slate-100 rounded-full overflow-hidden">
              <div class="h-full bg-gradient-to-r from-emerald-400 to-teal-500 rounded-full transition-all duration-1000 ease-out" style={`width: ${(Number(dim.score) / 5) * 100}%`}></div>
            </div>
            <span class="text-sm font-mono font-semibold text-slate-900 min-w-[2.5rem] text-right">{dim.score}</span>
          </div>
        </div>
      ))}
    </div>
    <div class="mt-5 pt-4 border-t border-slate-100 text-xs text-slate-500 flex items-start gap-2">
      <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
      <p class="m-0 leading-relaxed">
        <strong>打分说明：</strong>以上指标由本站按照固定权重标准统一计算生成。其中，稳定性直接决定了长期使用体验（占比30%），速度和延迟代表核心连接质量（共计40%）。各项得分为全满 5.0 分制。
      </p>
    </div>
  </div>
</div>
