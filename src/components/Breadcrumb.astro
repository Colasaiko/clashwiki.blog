---
interface Props {
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
---
<nav class="flex text-sm text-slate-500  mb-6" aria-label="Breadcrumb">
  <ol class="inline-flex items-center space-x-1 md:space-x-2">
    <li class="inline-flex items-center">
      <a href="/" class="hover:text-emerald-500 transition-colors">
        首页
      </a>
    </li>
    {items.map(item => (
      <li>
        <div class="flex items-center">
          <svg class="w-4 h-4 mx-1" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
          {item.href ? (
            <a href={item.href} class="hover:text-emerald-500 transition-colors ml-1 md:ml-2">{item.label}</a>
          ) : (
            <span class="text-slate-700  ml-1 md:ml-2 font-medium">{item.label}</span>
          )}
        </div>
      </li>
    ))}
  </ol>
</nav>
