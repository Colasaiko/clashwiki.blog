---
interface Props {
  title: string;
  description: string;
  url: string;
  category: string;
  pubDate: Date;
  image?: string;
}

const { title, description, url, category, pubDate, image } = Astro.props;
---
<a href={url} class="group block relative rounded-2xl transition-all duration-300 hover:shadow-[0_20px_40px_-15px_rgba(16,185,129,0.2)] hover:-translate-y-1 h-56 md:h-48 z-10">
  
  <!-- 裁剪容器：外部右上角探头 -->
  <div class="absolute left-0 right-0 bottom-full h-[80px] overflow-hidden pointer-events-none z-30">
    <!-- 小猫娘实体：默认探头，悬停时往下躲藏。增加 -bottom-5 抵消图片底部的透明留白 -->
    <div class="absolute right-8 -bottom-5 w-20 h-20 transition-transform duration-300 ease-out translate-y-0 group-hover:translate-y-[80px] opacity-100">
      <div class="relative w-full h-full">
        <img src="/peep-body.png" class="absolute inset-0 w-full h-full object-contain drop-shadow-sm" alt="ClashWiki Mascot Body" />
        <img src="/peep-eyes.png" class="peep-eyes-card absolute inset-0 w-full h-full object-contain transition-transform duration-100 ease-out" alt="ClashWiki Mascot Eyes" />
      </div>
    </div>
  </div>

  <!-- 内容与背景容器 (处理圆角和溢出裁剪) -->
  <div class="absolute inset-0 overflow-hidden rounded-2xl">
    <!-- Background Image or Placeholder -->
    {image ? (
      <img src={image} alt={title} class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
    ) : (
      <div class="absolute inset-0 w-full h-full bg-slate-800 flex items-center justify-center transition-transform duration-700 group-hover:scale-105">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-slate-600 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
        <span class="absolute text-sm font-medium text-slate-500 opacity-50">横版照片占位</span>
      </div>
    )}

    <!-- Gradient Overlay (to make text readable) -->
    <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-slate-900/40 to-transparent"></div>
    <div class="absolute inset-0 bg-slate-900/30 group-hover:bg-slate-900/10 transition-colors duration-300"></div>
    
    <!-- Border overlay -->
    <div class="absolute inset-0 border-2 border-emerald-500 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none z-20"></div>

    <!-- Content Overlay -->
    <div class="absolute inset-0 p-6 flex flex-col justify-end z-20 pr-8">
      <div class="flex items-center gap-3 mb-3">
        <span class="px-2.5 py-1 text-xs font-medium bg-emerald-500 text-white rounded-lg shadow-sm">
          {category}
        </span>
        <time class="text-xs text-slate-300 font-medium">
          {pubDate.toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}
        </time>
      </div>
      
      <h3 class="text-xl md:text-2xl font-heading font-semibold text-white mb-2 group-hover:text-emerald-400 transition-colors line-clamp-1">
        {title}
      </h3>
      
      <p class="text-slate-300 text-sm line-clamp-1 md:line-clamp-2 leading-relaxed opacity-90 group-hover:opacity-100 transition-opacity">
        {description}
      </p>
    </div>
  </div>
</a>
