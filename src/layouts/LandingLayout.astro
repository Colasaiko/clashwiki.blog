---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import BackButton from '../components/BackButton.astro';

interface Props {
  title: string;
  description: string;
  updatedDate: Date;
  brandName: string;
  keywords?: string;
  image?: string;
}

const { title, description, updatedDate, brandName, keywords, image } = Astro.props;
---

<BaseLayout title={title} description={description} keywords={keywords} bgImage="/content_bg.png" image={image}>
  <div class="bg-slate-900/60 backdrop-blur-2xl border-b border-white/40 pt-28 pb-12 shadow-sm">
    <div class="container mx-auto max-w-4xl px-4">
      <BackButton text="返回上一页" />
      <Breadcrumb items={[
        { label: '品牌库', href: '/brands/' },
        { label: brandName }
      ]} />
      
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mt-6">
        <div>
          <h1 class="text-3xl md:text-5xl font-bold font-heading text-slate-100  mb-4">
            {brandName} 评测与详情
          </h1>
          <p class="text-lg text-slate-400  max-w-2xl">
            {description}
          </p>
        </div>
      </div>
    </div>
  </div>

  <article class="container mx-auto max-w-4xl px-4 py-12">
    <div class="bg-slate-900 border border-slate-700 rounded-3xl p-6 md:p-10 lg:p-12 shadow-2xl mb-16 relative">
      <div class="prose-custom mx-auto">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>
