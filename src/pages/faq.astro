</BaseLayout>

<script>
  // 客户端高级搜索与分类联动逻辑
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('faq-search-input');
    const cards = document.querySelectorAll('.faq-card');
    const sections = document.querySelectorAll('.faq-category-section');
    const noResults = document.getElementById('faq-no-results');

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const searchTerm = e.target.value.toLowerCase().trim();
        let totalVisible = 0;

        // 重置或者按关键字过滤
        sections.forEach(section => {
          let sectionHasVisibleCard = false;
          const sectionCards = section.querySelectorAll('.faq-card');

          sectionCards.forEach(card => {
            const searchableText = card.getAttribute('data-search') || '';
            if (searchableText.includes(searchTerm)) {
              card.style.display = 'flex';
              sectionHasVisibleCard = true;
              totalVisible++;
            } else {
              card.style.display = 'none';
            }
          });

          // 如果该分类下没有可见卡片，隐藏整个分类标题区域
          if (sectionHasVisibleCard) {
            section.style.display = 'block';
          } else {
            section.style.display = 'none';
          }
        });

        // 控制"无结果"提示
        if (totalVisible === 0) {
          noResults.classList.remove('hidden');
        } else {
          noResults.classList.add('hidden');
        }
      });
    }
  });
</script>

