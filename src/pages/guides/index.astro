  <!-- Global CSS to hide scrollbar but allow scrolling -->
  <style is:global>
    .hide-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .hide-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
    html {
      scroll-behavior: smooth;
    }
