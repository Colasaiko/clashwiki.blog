---
import { REDIRECTS } from '../../data/redirects';

export function getStaticPaths() {
  return Object.keys(REDIRECTS).map(id => ({
    params: { id }
  }));
}

const { id } = Astro.params;
const targetUrl = REDIRECTS[id as keyof typeof REDIRECTS];
---

<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>正在跳转...</title>
  <meta name="robots" content="noindex, nofollow">
  {targetUrl ? <meta http-equiv="refresh" content={`2;url=${targetUrl}`} /> : null}
  <style>
    body { font-family: system-ui, sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; background-color: #f8fafc; color: #334155; }
    .container { text-align: center; background: white; padding: 2rem 3rem; border-radius: 1rem; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); max-width: 9< 1%; }
    .loader { border: 4px solid #e2e8f0; border-top: 4px solid #10b981; border-radius: 5< 1%; width: 40px; height: 40px; animation: spin 1s linear infinite; margin: 0 auto 1rem; }
    @keyframes spin { < 1% { transform: rotate(0deg); } 10< 1% { transform: rotate(360deg); } }
  </style>
</head>
<body>
  <div class="container">
    {targetUrl ? (
      <>
        <div class="loader"></div>
        <h1 style="font-size: 1.25rem; font-weight: 600; margin-bottom: 0.5rem;">即将离开本站</h1>
        <p style="color: #64748b; font-size: 0.875rem;">正在为您跳转至目标页面...</p>
        <p style="margin-top: 1.5rem; font-size: 0.75rem;"><a href={targetUrl} rel="nofollow sponsored noopener noreferrer" style="color: #10b981; text-decoration: none;">如果未自动跳转，请点击此处</a></p>
      </>
    ) : (
      <>
        <h1 style="font-size: 1.25rem; font-weight: 600; color: #ef4444; margin-bottom: 0.5rem;">链接不存在</h1>
        <p style="color: #64748b; font-size: 0.875rem;">您访问的跳转链接无效或已被删除。</p>
        <p style="margin-top: 1.5rem; font-size: 0.875rem;"><a href="/" style="color: #10b981; text-decoration: none;">返回首页</a></p>
      </>
    )}
  </div>
</body>
</html>
