---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<BaseLayout title="站内搜索 - ClashWiki" description="在 ClashWiki 中搜索您需要的教程、评测与网络诊断工具。" noindex={true}>
  <div class="container mx-auto max-w-5xl px-4 pt-28 pb-20 min-h-[70vh]">
    <Breadcrumb items={[{ label: '站内搜索' }]} />
    
    <div class="mt-8 mb-12">
      <SectionTitle title="搜索结果" subtitle="为您检索全站的相关教程、评测与指南。" align="center" asH1={true} />
    </div>

    <!-- 搜索输入框 (供重新搜索使用) -->
    <div class="max-w-2xl mx-auto mb-16 relative">
      <div class="absolute inset-0 bg-blue-500/10 rounded-2xl blur-xl transition-all duration-300"></div>
      <div class="relative flex items-center bg-slate-900 border border-slate-700 rounded-2xl p-2 focus-within:border-blue-500 focus-within:ring-1 focus-within:ring-blue-500 transition-all shadow-xl">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-slate-400 ml-4 mr-2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input id="searchInput" type="text" placeholder="输入关键字..." class="bg-transparent border-none text-slate-200 placeholder:text-slate-400 focus:outline-none w-full py-3 px-2 text-lg" autofocus />
      </div>
    </div>

    <!-- 搜索结果区 -->
    <div id="searchResults" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <div class="col-span-full text-center text-slate-400 py-12">
        <svg class="animate-spin h-8 w-8 text-blue-500 mx-auto mb-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        正在加载索引...
      </div>
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', async () => {
      const searchInput = document.getElementById('searchInput');
      const resultsContainer = document.getElementById('searchResults');
      let searchIndex = [];

      // 获取 URL 中的 q 参数
      const urlParams = new URLSearchParams(window.location.search);
      const initialQuery = urlParams.get('q');
      if (initialQuery) {
        searchInput.value = initialQuery;
      }

      // 获取索引数据
      try {
        const response = await fetch('/search.json');
        searchIndex = await response.json();
      } catch (e) {
        resultsContainer.innerHTML = '<div class="col-span-full text-center text-red-400 py-12">加载搜索数据失败，请刷新重试。</div>';
        return;
      }

      // 渲染文章卡片函数 (纯 JS)
      function renderCard(post) {
        // Simple client-side equivalent of ArticleCard.astro
        return `
        <a href="/blog/${post.slug}/" class="group block bg-slate-900 border border-slate-800 p-5 rounded-lg h-full flex flex-col transition-colors duration-200 hover:border-blue-500/50 hover:bg-slate-800/80">
          <div class="flex flex-col h-full">
            <div class="flex items-center gap-3 mb-3">
              <span class="text-xs font-semibold text-blue-400 uppercase tracking-wider">${post.category || '文章'}</span>
            </div>
            <h3 class="text-lg font-heading font-semibold text-slate-100 mb-2 group-hover:text-blue-400 transition-colors line-clamp-2">
              ${post.title}
            </h3>
            <p class="text-slate-400 text-sm line-clamp-2 mb-4 flex-grow leading-relaxed">
              ${post.description}
            </p>
            <div class="mt-auto flex items-center text-blue-500 text-sm font-medium">
              阅读详情
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1 group-hover:translate-x-1 transition-transform" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M12.293 5.293a1 1 0 011.414 0l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-2.293-2.293a1 1 0 010-1.414z" clip-rule="evenodd"></path>
              </svg>
            </div>
          </div>
        </a>`;
      }

      function performSearch(query) {
        if (!query || query.trim() === '') {
          resultsContainer.innerHTML = '<div class="col-span-full text-center text-slate-400 py-12">请输入关键字开始搜索</div>';
          return;
        }

        const q = query.toLowerCase().trim();
        const results = searchIndex.filter(post => {
          return (post.title && post.title.toLowerCase().includes(q)) || 
                 (post.description && post.description.toLowerCase().includes(q)) ||
                 (post.tags && post.tags.some(tag => tag.toLowerCase().includes(q)));
        });

        if (results.length === 0) {
          resultsContainer.innerHTML = '<div class="col-span-full text-center text-slate-400 py-12 text-lg">没有找到相关内容，换个关键字试试？</div>';
          return;
        }

        resultsContainer.innerHTML = results.map(renderCard).join('');
      }

      // 如果带有参数，直接搜索
      if (initialQuery) {
        performSearch(initialQuery);
      } else {
        resultsContainer.innerHTML = '<div class="col-span-full text-center text-slate-400 py-12">请输入关键字开始搜索</div>';
      }

      // 绑定输入事件 (防抖)
      let timeout;
      searchInput.addEventListener('input', (e) => {
        clearTimeout(timeout);
        timeout = setTimeout(() => {
          performSearch(e.target.value);
          // 更新 URL 参数但不刷新页面
          const newUrl = new URL(window.location);
          if (e.target.value) {
            newUrl.searchParams.set('q', e.target.value);
          } else {
            newUrl.searchParams.delete('q');
          }
          window.history.replaceState({}, '', newUrl);
        }, 300);
      });
    });
  </script>
</BaseLayout>
