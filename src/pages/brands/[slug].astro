---
import { getCollection, render } from 'astro:content';
import LandingLayout from '../../layouts/LandingLayout.astro';
import CTASection from '../../components/CTASection.astro';
import FAQ from '../../components/FAQ.astro';

export async function getStaticPaths() {
  const brands = await getCollection('brands');
  return brands.map(brand => ({
    params: { slug: brand.id.replace(/\.md$/, '') },
    props: { brand },
  }));
}

const { brand } = Astro.props;
const { Content } = await render(brand);

// Mock FAQ
const faqs = [
  { question: `${brand.data.name} 晚高峰速度怎么样？`, answer: '经过我们的多轮实测，该品牌在晚高峰表现十分稳定，足以支撑 4K 视频流畅播放。' },
  { question: `是否支持解锁 Netflix/Disney+？`, answer: '支持。提供多条原生 IP 线路和 DNS 解锁线路，大部分节点均可解锁流媒体。' },
  { question: `对新手友好吗？`, answer: '非常友好，提供全平台一键订阅以及详细的图文教程。' }
];

const seoKeywords = brand.data.tags ? [...brand.data.tags, "Clash", "便宜机场推荐", "科学上网"].join(", ") : "Clash, 便宜机场推荐, 科学上网";
---

<LandingLayout 
  title={`${brand.data.name} 评测与优惠码`} 
  description={brand.data.description}
  keywords={seoKeywords}
  updatedDate={brand.data.updatedDate}
  brandName={brand.data.name}
>
  <Content />
  
  <FAQ items={faqs} title="关于该品牌的常见问题" />
  
  <CTASection 
    title="立即注册体验" 
    description="点击下方按钮前往官网，使用本站专属优惠码可享受额外折扣。" 
    buttonText="前往官网注册" 
    buttonLink={`/go/${brand.id.replace(/\.md$/, '')}`} 
  />
</LandingLayout>
