---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const brands = await getCollection('brands');

const compareData = brands.map(brand => {
  const d = brand.data;
  
  // Calculate total score
  let totalScore = 0;
  if (d.scores) {
    totalScore = (
      (d.scores.stability * 0.3) +
      (d.scores.latency * 0.2) +
      (d.scores.speed * 0.2) +
      (d.scores.price * 0.15) +
      (d.scores.client_support * 0.1) +
      (d.scores.service * 0.05)
    );
  }
  const scoreStr = totalScore > 0 ? totalScore.toFixed(1) : '4.0';

  // Helper to determine status icon
  const getStatus = (score) => score >= 4.5 ? '✓' : (score >= 3.5 ? '△' : '✗');

  return {
    id: brand.id.replace(/\.md$/, ''),
    name: d.name,
    logo: d.image || '/images/brand_shield.jpg',
    corePersona: d.tags ? d.tags.slice(0, 2).join(' · ') : '精选服务商',
    monthly: '详见评测',
    yearly: '详见评测',
    traffic: '详见评测',
    lineType: d.protocols ? d.protocols[0] : '专线+中转',
    score: scoreStr,
    scores: d.scores,
    gaming: d.scores ? getStatus(d.scores.latency) : '△',
    streaming: d.scores ? getStatus(d.scores.speed) : '△',
    ai: d.scores ? getStatus(d.scores.client_support) : '△',
    recommendation: parseFloat(scoreStr) >= 4.5 ? '⭐⭐⭐⭐⭐' : '⭐⭐⭐⭐',
    targetAudience: d.audience?.suitable?.[0] || '广大跨境网络用户',
    priceLevel: d.scores?.price >= 4.5 ? '💰 (极具性价比)' : (d.scores?.price >= 3.5 ? '💰💰 (价格适中)' : '💰💰💰 (高端)'),
    killerFeature: d.pros?.[0] || '各方面表现均衡稳定',
    weakness: d.cons?.[0] || '服务细分领域略有欠缺',
    bestScenario: d.audience?.suitable?.[1] || d.audience?.suitable?.[0] || '日常多场景适用',
    url: `/brands/${brand.id.replace(/\.md$/, '')}/`
  };
});

// Sort by score descending
compareData.sort((a, b) => parseFloat(b.score) - parseFloat(a.score));
---

<BaseLayout title="2026最新产品终极横向测评对比雷达 | 代理对比 - ClashWiki" description="面对众多代理服务商无从下手？ClashWiki 独家跨品牌网络优化服务横评雷达，通过价格梯度、晚高峰延迟等真实数据，点击为您智能匹配最具性价比的完美节点。" keywords="横向测评,代理对比,价格梯度,智能匹配" >
  <!-- 页面背景氛围 -->
  <div class="fixed inset-0 z-[-1] pointer-events-none overflow-hidden bg-slate-900">
    <div class="absolute top-[-1< 1%] left-[-1< 1%] w-[50vw] h-[50vw] rounded-full bg-indigo-600/20 blur-[120px] mix-blend-screen"></div>
    <div class="absolute bottom-[-1< 1%] right-[-1< 1%] w-[60vw] h-[60vw] rounded-full bg-cyan-600/10 blur-[150px] mix-blend-screen"></div>
    <div class="absolute top-[4< 1%] left-[6< 1%] w-[30vw] h-[30vw] rounded-full bg-fuchsia-600/15 blur-[100px] mix-blend-screen"></div>
  </div>

  <div class="container mx-auto max-w-7xl px-4 pt-28 pb-20 relative z-10">
    <Breadcrumb items={[{ label: '产品对比' }]} />
    
    <div class="mt-8 mb-12 text-center">
      <h1 class="text-4xl md:text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-indigo-400 to-fuchsia-400 mb-4 tracking-tight">
        六机论剑
      </h1>
      <p class="text-lg text-slate-400 max-w-2xl mx-auto">
        “2026年内卷局：六大顶流机场，到底该翻谁的牌子？”
      </p>
    </div>

    <!-- 核心决策对比表 (Decision Table) -->
    <div class="mb-4 flex justify-end">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-slate-800/50 border border-slate-700/50 text-slate-400 text-xs font-medium">
        <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        数据最后核验：2026-08-13
      </div>
    </div>
    
    <div class="mb-20 overflow-x-auto bg-slate-900/50 backdrop-blur-xl rounded-3xl border border-slate-700/50 shadow-2xl shadow-indigo-900/20">
      <table class="w-full text-left border-collapse min-w-[800px]">
        <thead>
          <tr class="bg-slate-800/80 border-b border-slate-700/50 text-slate-300 text-sm tracking-wider">
            <th class="p-5 font-semibold rounded-tl-3xl">服务商</th>
            <th class="p-5 font-semibold">核心线路</th>
            <th class="p-5 font-semibold text-center text-emerald-400">综合评分</th>
            <th class="p-5 font-semibold text-center">稳定性</th>
            <th class="p-5 font-semibold text-center">速度</th>
            <th class="p-5 font-semibold text-center">价格定位</th>
            <th class="p-5 font-semibold text-center">流媒体4K</th>
            <th class="p-5 font-semibold text-center">AI解锁</th>
            <th class="p-5 font-semibold text-center rounded-tr-3xl">评级</th>
          </tr>
        </thead>
        <tbody class="text-slate-300 divide-y divide-slate-700/50">
          {compareData.map((brand, index) => (
            <tr class="hover:bg-slate-800/50 transition-colors">
              <td class="p-5 font-bold flex items-center gap-3">
                <a href={brand.url} class="flex items-center gap-3 group">
                  <img src={brand.logo} alt={brand.name} class="w-8 h-8 rounded-lg object-cover ring-1 ring-slate-700 group-hover:ring-indigo-400 transition-all" />
                  <span class="group-hover:text-indigo-400 transition-colors">{brand.name}</span>
                </a>
              </td>
              <td class="p-5 text-sm"><span class="px-2 py-1 bg-slate-800 rounded-md text-cyan-300 border border-cyan-900/50">{brand.lineType}</span></td>
              <td class="p-5 text-center font-black text-lg text-emerald-400">{brand.score}</td>
              <td class="p-5 text-center font-mono text-sm text-slate-300">{brand.scores?.stability.toFixed(1) || 'N/A'}</td>
              <td class="p-5 text-center font-mono text-sm text-slate-300">{brand.scores?.speed.toFixed(1) || 'N/A'}</td>
              <td class="p-5 text-center text-xs font-bold text-amber-400">{brand.priceLevel}</td>
              <td class="p-5 text-center font-bold" class:list={[{'text-emerald-400': brand.streaming === '✓', 'text-amber-400': brand.streaming === '△', 'text-rose-400': brand.streaming === '✗'}]}>{brand.streaming}</td>
              <td class="p-5 text-center font-bold" class:list={[{'text-emerald-400': brand.ai === '✓', 'text-amber-400': brand.ai === '△', 'text-rose-400': brand.ai === '✗'}]}>{brand.ai}</td>
              <td class="p-5 text-center tracking-widest text-xs">{brand.recommendation}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- 响应式对比卡片网格 -->
    <div class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-8">
      {compareData.map((brand) => (
        <div class="group relative flex flex-col rounded-3xl overflow-hidden transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_40px_-15px_rgba(99,102,241,0.3)]">
          <!-- 玻璃拟物背景层 -->
          <div class="absolute inset-0 bg-slate-800/40 backdrop-blur-xl border border-slate-700/50 rounded-3xl transition-colors duration-500 group-hover:bg-slate-800/60 group-hover:border-indigo-500/30 z-0"></div>
          
          <!-- 顶部品牌信息 -->
          <div class="relative z-10 p-6 sm:p-8 flex items-center space-x-5 border-b border-slate-700/50 bg-slate-900/20">
            <div class="w-16 h-16 rounded-2xl overflow-hidden shrink-0 ring-2 ring-slate-700/50 group-hover:ring-indigo-400/50 transition-all duration-300">
              <img src={brand.logo} alt={brand.name} width="120" height="120" class="w-full h-full object-cover object-right group-hover:scale-110 transition-transform duration-500" />
            </div>
            <div>
              <h2 class="text-2xl font-bold text-slate-100 mb-1 group-hover:text-indigo-300 transition-colors duration-300">{brand.name}</h2>
              <p class="text-sm font-semibold text-emerald-400">{brand.corePersona}</p>
            </div>
          </div>

          <!-- 核心参数列表 -->
          <div class="relative z-10 p-6 sm:p-8 flex-grow flex flex-col space-y-5">
            
            <div class="grid grid-cols-2 gap-x-4 gap-y-3 bg-slate-900/50 rounded-2xl p-4 border border-slate-700/30">
              <div>
                <p class="text-[11px] text-slate-500 mb-0.5 font-medium tracking-wider uppercase">起步月付</p>
                <p class="text-lg font-bold text-emerald-400">{brand.monthly}</p>
              </div>
              <div>
                <p class="text-[11px] text-slate-500 mb-0.5 font-medium tracking-wider uppercase">最低年付</p>
                <p class="text-lg font-bold text-cyan-400">{brand.yearly}</p>
              </div>
              <div class="col-span-2 border-t border-slate-700/30 pt-3 mt-1 grid grid-cols-2 gap-4">
                <div>
                  <p class="text-[11px] text-slate-500 mb-0.5 font-medium tracking-wider uppercase">目标受众</p>
                  <p class="text-sm font-bold text-slate-200">{brand.targetAudience}</p>
                </div>
                <div>
                  <p class="text-[11px] text-slate-500 mb-0.5 font-medium tracking-wider uppercase">价格定位</p>
                  <p class="text-sm font-bold text-amber-400">{brand.priceLevel}</p>
                </div>
              </div>
            </div>

            <div class="space-y-4 flex-grow">
              
              <div class="bg-indigo-900/10 border border-indigo-500/10 rounded-xl p-4">
                <div class="flex items-center text-sm font-medium text-indigo-300 mb-1.5">
                  <svg class="w-4 h-4 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                  </svg>
                  核心杀手锏
                </div>
                <p class="text-sm text-slate-300 leading-relaxed font-medium">{brand.killerFeature}</p>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div class="bg-rose-900/10 border border-rose-500/10 rounded-xl p-3">
                  <div class="flex items-center text-xs font-medium text-rose-400 mb-1">
                    <svg class="w-3.5 h-3.5 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
                    </svg>
                    致命短板
                  </div>
                  <p class="text-xs text-slate-400">{brand.weakness}</p>
                </div>
                <div class="bg-cyan-900/10 border border-cyan-500/10 rounded-xl p-3">
                  <div class="flex items-center text-xs font-medium text-cyan-400 mb-1">
                    <svg class="w-3.5 h-3.5 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    最佳场景
                  </div>
                  <p class="text-xs text-slate-400">{brand.bestScenario}</p>
                </div>
              </div>
              
            </div>
          </div>

          <!-- 底部按钮 -->
          <div class="relative z-10 p-6 sm:px-8 sm:pb-8 pt-0 mt-auto">
            <a href={brand.url} class="flex items-center justify-center w-full py-3.5 px-4 bg-gradient-to-r from-indigo-500/20 to-cyan-500/20 hover:from-indigo-500/40 hover:to-cyan-500/40 border border-indigo-500/30 rounded-xl text-indigo-300 font-semibold transition-all duration-300 group-hover:text-white group-hover:border-indigo-400 shadow-lg shadow-indigo-900/20">
              <span>查看深度评测</span>
              <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</BaseLayout>
