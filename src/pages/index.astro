---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ArticleCard from '../components/ArticleCard.astro';
import BrandCard from '../components/BrandCard.astro';
import FeatureCard from '../components/FeatureCard.astro';
import FAQ from '../components/FAQ.astro';
import { getCollection } from 'astro:content';

// Fetch ALL posts
const allBlogPosts = await getCollection('blog');

// 2. VPN 指南
const vpnPosts = allBlogPosts
  .filter(post => post.data.tags?.includes('vpn'))
  .sort((a, b) => new Date(b.data.pubDate || new Date()).valueOf() - new Date(a.data.pubDate || new Date()).valueOf())
  .slice(0, 4)
  .map(post => ({
    title: post.data.title,
    description: post.data.description,
    url: `/blog/${post.slug || post.id.replace(/\.md$/, '')}/`,
    category: post.data.category || 'VPN',
    pubDate: new Date(post.data.pubDate || new Date())
  }));

// 4. 实用工具 (Tools)
const toolsData = [
  { title: 'Clash 配置大全', description: 'Windows, Mac, Android, iOS 全平台使用教程。', icon: 'lightning', url: '/tag/clash/' },
  { title: 'IP 与归属查询', description: '查看您的真实出口 IP 地址及归属地信息。', icon: 'globe', url: '/tools/ip/' },
  { title: 'DNS 泄露测试', description: '检测您的网络请求是否存在 DNS 泄露风险。', icon: 'shield', url: '/tools/dns-leak/' },
  { title: 'WebRTC 泄露检测', description: '检查浏览器是否通过 WebRTC 泄露真实 IP。', icon: 'lock', url: '/tools/webrtc/' }
];

// 5. AI 工具
const aiPosts = allBlogPosts
  .filter(post => post.data.tags?.includes('ai-tools') || post.data.tags?.includes('chatgpt') || post.data.tags?.includes('claude'))
  .sort((a, b) => new Date(b.data.pubDate || new Date()).valueOf() - new Date(a.data.pubDate || new Date()).valueOf())
  .slice(0, 4)
  .map(post => ({
    title: post.data.title,
    description: post.data.description,
    url: `/blog/${post.slug || post.id.replace(/\.md$/, '')}/`,
    category: post.data.category || 'AI 工具',
    pubDate: new Date(post.data.pubDate || new Date())
  }));

// 6. 最新教程
const latestPosts = allBlogPosts
  .filter(post => !post.data.tags?.includes('vpn') && !post.data.tags?.includes('ai-tools'))
  .sort((a, b) => new Date(b.data.pubDate || new Date()).valueOf() - new Date(a.data.pubDate || new Date()).valueOf())
  .slice(0, 4)
  .map(post => ({
    title: post.data.title,
    description: post.data.description,
    url: `/blog/${post.slug || post.id.replace(/\.md$/, '')}/`,
    category: post.data.category || '文章',
    pubDate: new Date(post.data.pubDate || new Date())
  }));

const homeFaqs = [
  {
    question: 'VPN 与专线有什么区别？',
    answer: 'VPN (虚拟专用网络) 注重隐私加密，通过专门的协议保护数据安全；专线 (代理服务) 通常基于 Shadowsocks、Vmess、Trojan 等协议，主要侧重于跨境访问的速度与流媒体解锁。'
  },
  {
    question: '新手应该怎么选择？',
    answer: '如果您是初学者，仅需要流畅访问海外网站和观看流媒体，直接选择优质的“专线”服务最具性价比；如果您有极高的隐私保护需求或企业合规要求，请选择老牌的 VPN。'
  },
  {
    question: '这里的评测数据客观吗？',
    answer: '我们的评测数据均来源于独立的千兆环境测速和长期的稳定性监控。虽然部分评测可能包含商业推广链接，但我们严格遵循数据真实性原则，绝不伪造测速图表或虚构评价。'
  }
];
