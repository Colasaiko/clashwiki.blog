---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import StatsStrip from '../components/StatsStrip.astro';
import SectionTitle from '../components/SectionTitle.astro';
import FeatureCard from '../components/FeatureCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import BannerArticleCard from '../components/BannerArticleCard.astro';
import TopicCluster from '../components/TopicCluster.astro';
import BrandCard from '../components/BrandCard.astro';

import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import { HOMEPAGE_DATA } from '../data/homepage';
import { getCollection } from 'astro:content';
import { getPostsForTopic } from '../utils/topics';

const allBlogPosts = await getCollection('blog');
const latestPosts = allBlogPosts
  .sort((a, b) => new Date(b.data.pubDate || new Date()).valueOf() - new Date(a.data.pubDate || new Date()).valueOf())
  .slice(0, 6)
  .map(post => {
    return {
      title: post.data.title,
      description: post.data.description,
      url: `/blog/${post.slug || post.id.replace(/\.md$/, '')}/`,
      category: post.data.category,
      pubDate: new Date(post.data.pubDate || new Date()),
      image: post.data.image
    };
  });

const rawTopicsData = [
  { title: '新手小白必看', description: '从零开始的跨境网络配置指南', slug: 'beginners', url: '/topics/beginners/' },
  { title: '流媒体解锁', description: 'Netflix, Disney+, YouTube Premium 解锁评测', slug: 'streaming', url: '/topics/streaming/' },
  { title: '性价比之选', description: '月均 15 元以下的高质量平价机场', slug: 'budget', url: '/topics/budget/' },
  { title: '客户端配置大全', description: '各平台代理软件下载与实操图文指南', slug: 'clients', url: '/topics/clients/' },
  { title: '避坑指南', description: '揭秘机场圈套路，教你如何辨别劣质与跑路机场', slug: 'scam-avoidance', url: '/topics/scam-avoidance/' },
  { title: '进阶玩法', description: '分流规则配置、自建节点与底层协议深度解析', slug: 'advanced', url: '/topics/advanced/' },
];

const topicsData = rawTopicsData.map(topic => ({
  ...topic,
  count: getPostsForTopic(topic.slug, allBlogPosts).length
}));

const allBrandsData = await getCollection('brands');
const brandsData = allBrandsData.map(b => ({
  name: b.data.name,
  description: b.data.description,
  url: `/brands/${b.id.replace(/\.md$/, '')}/`,
  buyUrl: `/go/${b.id.replace(/\.md$/, '')}`,
  tags: b.data.tags || [],
  image: b.data.image,
  scores: b.data.scores
}));
---

<BaseLayout title="2026最新高性价比网络代理商推荐 | 网络诊断 - ClashWiki" description="不知道如何挑选稳定高速的网络代理？ClashWiki 呈现全网最新高性价比机场横评、晚高峰节点跑速公开数据以及全平台图文配置指南，点击开启极速网络优化体验。" keywords="网络代理,机场横评,晚高峰跑速,配置指南" >
  <Hero brandCount={allBrandsData.length} />
  
  <div class="container mx-auto max-w-6xl px-4 mt-8">
    
    <!-- 1. Network Tools -->
    <section id="network-tools" class="py-16 flex flex-col justify-center scroll-mt-0">
      <div class="w-full mb-12">
        <SectionTitle title="网络工具导航" subtitle="涵盖主流代理内核与全平台客户端的详尽配置指南。" align="left" />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 gap-y-12 mt-4">
        {HOMEPAGE_DATA.networkTools.map(feat => (
          <FeatureCard title={feat.title} description={feat.description} icon={feat.icon} href={feat.href} />
        ))}
      </div>
    </section>

    <!-- 2. Diagnostics -->
    <section id="diagnostics" class="py-16 flex flex-col justify-center scroll-mt-0 border-t border-slate-100">
      <div class="w-full mb-12">
        <SectionTitle title="网络诊断工具箱" subtitle="快速检测您的出口 IP 纯净度、DNS 泄露及节点真实延迟。" align="left" />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 gap-y-12 mt-4">
        {HOMEPAGE_DATA.diagnostics.map(feat => (
          <FeatureCard title={feat.title} description={feat.description} icon={feat.icon} href={feat.href} />
        ))}
      </div>
    </section>

    <!-- 3. AI Tools -->
    <section id="ai-tools" class="py-16 flex flex-col justify-center scroll-mt-0 border-t border-slate-100">
      <div class="w-full mb-12">
        <SectionTitle title="AI 生产力工具专区" subtitle="ChatGPT、Claude 等前沿 AI 工具的注册、解锁与原生 IP 验证指南。" align="left" />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 gap-y-12 mt-4">
        {HOMEPAGE_DATA.aiTools.map(feat => (
          <FeatureCard title={feat.title} description={feat.description} icon={feat.icon} href={feat.href} />
        ))}
      </div>
    </section>

  </div>

  <!-- 4. Latest Posts -->
  <section id="latest-posts" class="py-12 md:py-16 scroll-mt-0 relative overflow-hidden">
    <div class="absolute inset-0 z-0 pointer-events-none">
      <img src="/background2.png" alt="ClashWiki 2026 Background Theme" width="1920" height="1080" class="w-full h-full object-cover object-right-top" />
      <div class="absolute inset-0 bg-white/40 backdrop-blur-[2px]"></div>
    </div>
    <div class="relative z-10 container mx-auto max-w-7xl px-4">
      <div class="w-full flex justify-between items-end mb-8">
        <SectionTitle title="实用教程与最新内容" align="left" />
        <a href="/blog/" class="hidden md:inline-block text-emerald-600 font-medium hover:text-emerald-700 mb-6 bg-white/90 backdrop-blur-md px-5 py-2.5 rounded-full shadow-sm hover:shadow transition-all">查看全部文章 &rarr;</a>
      </div>
      <div class="grid grid-cols-1 gap-y-6 mt-6 w-full max-w-5xl mx-auto">
        {latestPosts.map(post => (
          <BannerArticleCard {...post} />
        ))}
      </div>
      <div class="mt-8 text-center md:hidden">
        <a href="/blog/" class="btn-secondary inline-block">查看全部文章</a>
      </div>
    </div>
  </section>

  <div class="container mx-auto max-w-6xl px-4">
    <!-- Topic Clusters -->
    <section id="topics" class="py-16 scroll-mt-0">
      <SectionTitle title="热门专题聚合" subtitle="按您的核心需求快速定位教程库" />
      <TopicCluster topics={topicsData} />
    </section>

    <!-- SEO Content Placeholder -->
    <section class="py-16 prose-custom max-w-4xl mx-auto border-t border-slate-100 mt-8">
      <h2>专业的网络与 AI 工具体验数据库</h2>
      <p>在寻找<strong>前沿生产力工具</strong>的过程中，很多用户往往被华丽的广告词误导。为此我们通过搜集、整理公开信息和官方资料，建立了涵盖节点表现预估、流媒体解锁状态及性价比分析的综合数据库。无论您是寻找<strong>高性价比网络优化服务</strong>，还是对连通性要求极高的<strong>企业级网络专线</strong>，都能在这里找到客观的数据支撑。</p>
      <h3>为什么需要客观的网络体验数据库？</h3>
      <p>随着国际互联网环境的复杂化，传统的直连方式常常面临严重的路由绕道甚至 IP 阻断。高质量的 <strong>跨境网络优化服务</strong>能够提供更稳定的内网传输，有效保障跨国视频会议、海外开发与外贸业务的流畅度。</p>
    </section>

    <!-- FAQ -->
    <section id="faqs" class="py-16">
      <FAQ items={HOMEPAGE_DATA.faqs} />
    </section>
  </div>

  <!-- 5. Brands (Moved to the bottom, before CTA) -->
  <section id="brands" class="py-24 scroll-mt-0 relative overflow-hidden mt-12 mb-12">
    <div class="absolute inset-0 z-0 pointer-events-none">
      <img src="/background3.png" alt="ClashWiki Airport Review Background" width="1920" height="1080" class="w-full h-full object-cover object-center" />
      <div class="absolute inset-0 bg-white/40 backdrop-blur-[2px]"></div>
    </div>
    <div class="relative z-10 container mx-auto max-w-6xl px-4">
      <div class="mb-8">
        <SectionTitle title="网络服务商综合榜单" subtitle="基于全网公开资料与服务商基础数据汇总的优质节点推荐榜单，客观呈现各家特色。" align="left" />
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-x-6 gap-y-32 mt-32">
        {brandsData.map(brand => (
          <BrandCard {...brand} />
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <div class="container mx-auto max-w-6xl px-4 mb-20">
    <CTASection 
      title="准备好搭建您的专属网络环境了吗？" 
      description="查看我们最新更新的 2026 节点表现预估榜单与详尽配置指南。" 
      buttonText="查看公开数据评估榜单" 
      buttonLink="/category/airports/" 
    />
  </div>
</BaseLayout>
