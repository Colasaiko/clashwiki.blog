---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import FAQ from '../../components/FAQ.astro';
import CTASection from '../../components/CTASection.astro';
import TableOfContents from '../../components/TableOfContents.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

// Calculate related posts based on tag relevance
const allPosts = await getCollection('blog');
const currentTags = post.data.tags || [];

const related = allPosts
  .filter(p => p.id !== post.id)
  .map(p => {
    const pTags = p.data.tags || [];
    let score = 0;
    // Base score for same category
    if (p.data.category === post.data.category) score += 2;
    // High score for shared tags
    const sharedTags = pTags.filter(tag => currentTags.includes(tag));
    score += sharedTags.length * 5;
    return { post: p, score };
  })
  .filter(item => item.score > 0)
  .sort((a, b) => b.score - a.score)
  .map(item => item.post)
  .slice(0, 6);

const slug = post.id.replace(/\.md$/, '');

let ctaTitle = "正在寻找稳定可靠的网络服务？";
let ctaDesc = "我们深度测试了市面上的主流服务商，为您整理了客观、中立的推荐榜单与评分。";
let btnText = "查看机场服务商推荐榜单";
let btnLink = "/brands/";

if (slug.startsWith('seo-brand-')) {
  const brandName = slug.replace('seo-brand-', '');
  ctaTitle = "对该品牌感兴趣？";
  ctaDesc = "查看我们在多维度的详细测试数据、流媒体解锁报告以及最新的可用优惠码。";
  btnText = "查看完整评测与评分数据";
  btnLink = `/brands/${brandName}/`;
}
---

<BlogLayout {...post.data}>
  <div slot="article-content">
    <TableOfContents headings={headings} />
    <Content />
  </div>
  
  <div slot="after-article" class="w-full clear-both">
    {related.length > 0 && <RelatedPosts posts={related} />}
    
    <CTASection 
      title={ctaTitle} 
      description={ctaDesc} 
      buttonText={btnText} 
      buttonLink={btnLink} 
    />
  </div>
</BlogLayout>
