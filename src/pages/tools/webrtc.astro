---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/SectionTitle.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import HubFooterLinks from '../../components/HubFooterLinks.astro';
---

<BaseLayout keywords="WebRTC测试, WebRTC泄漏, 真实IP检测, 局域网IP" title="WebRTC 泄漏探测测试 | ClashWiki" description="免费的 WebRTC 隐私防泄漏测试工具。一键检测您的浏览器是否在连接代理时，意外泄露了您的真实局域网或本地公网 IP 地址。">
  <div class="container mx-auto max-w-4xl px-4 pt-28 pb-12 min-h-[80vh]">
    <Breadcrumb items={[ { label: '网络工具箱', href: '/tools/' }, { label: 'WebRTC 泄漏探测' } ]} />
    
    <div class="mt-8 mb-12">
      <SectionTitle title="WebRTC 泄漏探测" subtitle="深度嗅探浏览器底层，检测您的真实 IP 是否绕过代理遭到裸奔泄露。" align="left" asH1={true} />
    </div>

    <!-- UI Panel -->
    <div class="bg-slate-900 rounded-2xl shadow-sm border border-slate-700 p-8">
      <div class="flex items-center justify-between mb-8 pb-6 border-b border-slate-800">
        <h2 class="text-xl font-bold text-slate-200">底层探测结果</h2>
        <span id="webrtc-status" class="text-slate-400 text-sm flex items-center gap-2">
          正在嗅探 ICE Candidates...
        </span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
          <p class="text-sm text-slate-400 mb-1">抓取到的私有 IP (Local)</p>
          <div id="local-ips" class="text-lg font-medium text-amber-600 font-mono flex flex-col gap-1">等待中...</div>
        </div>
        
        <div>
          <p class="text-sm text-slate-400 mb-1">抓取到的公网 IP (Public)</p>
          <div id="public-ips" class="text-lg font-medium text-rose-600 font-mono flex flex-col gap-1">等待中...</div>
        </div>
      </div>
      
      <div class="mt-8 pt-6 border-t border-slate-800">
        <button id="refresh-btn" class="px-5 py-2.5 bg-slate-800 hover:bg-slate-200 text-slate-300 rounded-lg text-sm font-medium transition-colors">重新探测</button>
      </div>
    </div>

    <!-- Explainer -->
    <div class="mt-12 prose-custom max-w-none text-sm text-slate-400 bg-slate-800 rounded-xl p-6">
      <h3 class="text-base font-bold text-slate-200 mb-2">什么是 WebRTC 泄漏？</h3>
      <p>WebRTC 是浏览器内置的实时通信技术，允许直接进行端到端音视频通话。然而，它的机制允许网页通过 STUN 服务器获取您的真实 IP 地址。<strong>即使您使用了全局代理插件，如果不禁用或接管 WebRTC，您的真实宽带公网 IP 依然会被暴露。</strong></p>
      
      <h3 class="text-base font-bold text-slate-200 mt-4 mb-2">如何修复？</h3>
      <ul class="mt-2 space-y-1">
        <li><strong>浏览器插件用户：</strong> 推荐安装 <code>WebRTC Network Limiter</code> (Chrome) 或 <code>Disable WebRTC</code>，强制通过代理路由 WebRTC 流量。</li>
        <li><strong>系统级代理用户：</strong> 像 Clash / sing-box 的 TUN 模式可以在虚拟网卡层面接管所有流量，通常能完美防止 WebRTC 泄漏。</li>
        <li><strong>注意事项：</strong> 现代浏览器为了隐私，部分局域网 IP 可能显示为 <code>.local</code> (mDNS) 掩码，这属于正常安全保护行为。</li>
      </ul>
    </div>
    <HubFooterLinks />
  </div>
</BaseLayout>

<script>
  function findIPs() {
    const localContainer = document.getElementById('local-ips');
    const publicContainer = document.getElementById('public-ips');
    const statusEl = document.getElementById('webrtc-status');
    
    localContainer.innerHTML = '';
    publicContainer.innerHTML = '';
    
    statusEl.innerHTML = '<svg class="animate-spin h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> 探测中...';

    const myPeerConnection = window.RTCPeerConnection || window.mozRTCPeerConnection || window.webkitRTCPeerConnection;
    if (!myPeerConnection) {
      localContainer.innerHTML = '<span class="text-slate-400">浏览器不支持 WebRTC</span>';
      publicContainer.innerHTML = '<span class="text-slate-400">浏览器不支持 WebRTC</span>';
      statusEl.innerText = "探测结束";
      return;
    }

    const pc = new myPeerConnection({
      iceServers: [
        {urls: "stun:stun.l.google.com:19302"},
        {urls: "stun:stun1.l.google.com:19302"}
      ]
    });
    
    const noop = function() {};
    const localIPs = {};
    const ipRegex = /([0-9]{1,3}(\.[0-9]{1,3}){3}|[a-f0-9]{1,4}(:[a-f0-9]{1,4}){7})/g;
    
    let foundLocal = false;
    let foundPublic = false;

    function handleIP(ip) {
      if (localIPs[ip]) return;
      localIPs[ip] = true;
      
      const el = document.createElement('div');
      el.innerText = ip;
      
      // 简单判断是公网还是局域网 (包含 mDNS)
      if (ip.match(/^(192\.168\.|169\.254\.|10\.|172\.(1[6-9]|2\d|3[0-1]))/) || ip.endsWith('.local')) {
        localContainer.appendChild(el);
        foundLocal = true;
      } else {
        publicContainer.appendChild(el);
        foundPublic = true;
      }
    }

    pc.createDataChannel("");
    pc.createOffer().then(function(sdp) {
      sdp.sdp.split('\n').forEach(function(line) {
        if (line.indexOf('candidate') < 0) return;
        line.match(ipRegex)?.forEach(handleIP);
      });
      pc.setLocalDescription(sdp, noop, noop);
    }).catch(function(reason) {
      // ignore
    });

    pc.onicecandidate = function(ice) {
      if (!ice || !ice.candidate || !ice.candidate.candidate || !ice.candidate.candidate.match(ipRegex)) return;
      ice.candidate.candidate.match(ipRegex).forEach(handleIP);
    };

    // 5秒后停止
    setTimeout(() => {
      pc.close();
      if (!foundLocal) localContainer.innerHTML = '<span class="text-emerald-500 font-bold">未检测到泄漏 (Safe)</span>';
      if (!foundPublic) publicContainer.innerHTML = '<span class="text-emerald-500 font-bold">未检测到泄漏 (Safe)</span>';
      statusEl.innerText = "✅ 嗅探完成";
      statusEl.className = "text-emerald-500 text-sm font-bold";
    }, 5000);
  }

  document.addEventListener('DOMContentLoaded', findIPs);
  document.getElementById('refresh-btn')?.addEventListener('click', findIPs);
</script>
