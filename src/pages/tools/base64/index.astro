---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import HubFooterLinks from '../../../components/HubFooterLinks.astro';
---

<BaseLayout 
  title="Base64在线编码解码安全工具 | ClashWiki" 
  description="免费安全的 Base64 在线转换工具。支持代理订阅链接解码、文本加解密。纯前端运行，数据绝不上传服务器，100% 保障您的隐私安全。"
>
  <div class="container mx-auto max-w-5xl px-4 pt-28 pb-20">
    <Breadcrumb items={[
      { label: '工具箱', href: '/tools/' },
      { label: 'Base64 编码解码' }
    ]} />

    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-400 mb-4 tracking-tight">
        Base64 编码解码工具
      </h1>
      <p class="text-lg text-slate-400 max-w-2xl mx-auto">
        纯前端运行，您的数据绝对安全。常用于解析各种代理订阅链接与配置文件。
      </p>
    </div>

    <div class="bg-slate-900 border border-slate-800 rounded-3xl p-6 md:p-10 shadow-xl max-w-4xl mx-auto">
      
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Input Section -->
        <div class="flex flex-col h-full">
          <label class="text-sm font-bold text-slate-300 mb-2 flex items-center justify-between">
            <span>输入内容</span>
            <button id="btn-clear" class="text-xs text-slate-400 hover:text-rose-400 transition-colors">清空</button>
          </label>
          <textarea 
            id="input-text" 
            class="w-full flex-grow min-h-[300px] bg-slate-950 border border-slate-800 rounded-xl p-4 text-slate-200 font-mono text-sm focus:ring-2 focus:ring-blue-500/50 focus:border-blue-500 transition-all resize-none"
            placeholder="在此粘贴需要编码或解码的文本（如：vmess://... 或者普通的字符串）"
          ></textarea>
        </div>

        <!-- Output Section -->
        <div class="flex flex-col h-full">
          <label class="text-sm font-bold text-slate-300 mb-2 flex items-center justify-between">
            <span>输出结果</span>
            <button id="btn-copy" class="text-xs text-blue-400 hover:text-blue-300 transition-colors flex items-center gap-1">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              复制结果
            </button>
          </label>
          <textarea 
            id="output-text" 
            class="w-full flex-grow min-h-[300px] bg-slate-950/50 border border-slate-800 rounded-xl p-4 text-slate-400 font-mono text-sm focus:outline-none resize-none"
            placeholder="转换后的结果将在此显示"
            readonly
          ></textarea>
        </div>
      </div>

      <!-- Actions -->
      <div class="flex flex-wrap justify-center gap-4 mt-8">
        <button id="btn-encode" class="px-8 py-3 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-xl shadow-lg shadow-blue-900/20 transition-all active:scale-95 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          进行 Base64 编码
        </button>
        <button id="btn-decode" class="px-8 py-3 bg-indigo-600 hover:bg-indigo-500 text-white font-bold rounded-xl shadow-lg shadow-indigo-900/20 transition-all active:scale-95 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          进行 Base64 解码
        </button>
      </div>
      
      <!-- Alert Message -->
      <div id="toast" class="fixed bottom-10 left-1/2 -translate-x-1/2 bg-slate-800 text-white px-6 py-3 rounded-full shadow-2xl border border-slate-700 opacity-0 translate-y-10 transition-all duration-300 pointer-events-none z-50">
        复制成功！
      </div>

    </div>

    <!-- SEO / 说明 -->
    <div class="max-w-4xl mx-auto mt-16 prose prose-invert prose-slate">
      <h2>为什么代理玩家需要 Base64 工具？</h2>
      <p>
        在网络代理领域，服务商通常会将大量的节点配置信息打包成一行订阅链接。为了防止传输过程中特殊字符（如换行符、引号）引发错误，这些数据几乎全部使用 <strong>Base64</strong> 进行编码。
      </p>
      <ul>
        <li><strong>节点解析：</strong> 早期的 <code>vmess://</code> 链接，其后面的内容就是一段被 Base64 编码的 JSON 字符串。解码后，你可以清晰地看到服务器的真实 IP、端口和 UUID。</li>
        <li><strong>订阅解析：</strong> 如果你用浏览器直接打开服务商的订阅链接，你会看到一堆乱码字母。将其复制到上面的工具进行解码，你会发现它其实是一行一行的节点链接。</li>
        <li><strong>隐私保障：</strong> 本站工具完全基于您的本地浏览器 JavaScript 运行，绝不会向任何后端服务器发送您的输入数据，确保节点密码不会泄露。</li>
      </ul>
    </div>
    <HubFooterLinks />
  </div>
</BaseLayout>

<script>
  // Setup logic on client
  document.addEventListener('DOMContentLoaded', () => {
    const input = document.getElementById('input-text') as HTMLTextAreaElement;
    const output = document.getElementById('output-text') as HTMLTextAreaElement;
    const btnEncode = document.getElementById('btn-encode');
    const btnDecode = document.getElementById('btn-decode');
    const btnClear = document.getElementById('btn-clear');
    const btnCopy = document.getElementById('btn-copy');
    const toast = document.getElementById('toast');

    let toastTimeout;
    const showToast = (msg, isError = false) => {
      if (toast) {
        toast.textContent = msg;
        toast.className = `fixed bottom-10 left-1/2 -translate-x-1/2 px-6 py-3 rounded-full shadow-2xl border transition-all duration-300 pointer-events-none z-50 ${isError ? 'bg-rose-900/90 text-rose-200 border-rose-800' : 'bg-slate-800 text-white border-slate-700'}`;
        toast.style.opacity = '1';
        toast.style.transform = 'translate(-50%, 0)';
        clearTimeout(toastTimeout);
        toastTimeout = setTimeout(() => {
          toast.style.opacity = '0';
          toast.style.transform = 'translate(-50%, 20px)';
        }, 3000);
      }
    };

    // Encode
    btnEncode?.addEventListener('click', () => {
      try {
        if (!input.value.trim()) return;
        // Support UTF-8
        const utf8Bytes = new TextEncoder().encode(input.value);
        const base64 = btoa(String.fromCharCode(...utf8Bytes));
        output.value = base64;
        output.classList.add('text-slate-200');
        output.classList.remove('text-slate-400');
      } catch (e) {
        showToast('编码失败，输入包含了无效字符', true);
      }
    });

    // Decode
    btnDecode?.addEventListener('click', () => {
      try {
        if (!input.value.trim()) return;
        // Basic cleanup for standard base64 (remove whitespaces)
        const cleanBase64 = input.value.replace(/\s+/g, '');
        const binaryString = atob(cleanBase64);
        const bytes = new Uint8Array(binaryString.length);
        for (let i = 0; i < binaryString.length; i++) {
          bytes[i] = binaryString.charCodeAt(i);
        }
        const decoded = new TextDecoder().decode(bytes);
        output.value = decoded;
        output.classList.add('text-slate-200');
        output.classList.remove('text-slate-400');
      } catch (e) {
        output.value = '错误：输入不是有效的 Base64 格式字符串。';
        output.classList.add('text-rose-400');
        output.classList.remove('text-slate-200', 'text-slate-400');
        showToast('解码失败', true);
      }
    });

    // Clear
    btnClear?.addEventListener('click', () => {
      input.value = '';
      output.value = '';
      output.classList.remove('text-slate-200', 'text-rose-400');
      output.classList.add('text-slate-400');
    });

    // Copy
    btnCopy?.addEventListener('click', () => {
      if (output.value) {
        navigator.clipboard.writeText(output.value).then(() => {
          showToast('结果已复制到剪贴板！');
        });
      }
    });
  });
</script>
