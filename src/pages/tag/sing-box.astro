---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import HubFooterLinks from '../../components/HubFooterLinks.astro';
import PageQuickRead from '../../components/PageQuickRead.astro';

// 获取所有文章，按时间倒序
const allPosts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 按照规则筛选文章分类并格式化属性
const getSlug = (p) => p.slug || p.id.replace(/\.md$/, '');
const formatPost = (p) => ({
  title: p.data.title,
  description: p.data.description,
  url: `/blog/${getSlug(p)}/`,
  category: p.data.category || 'sing-box',
  pubDate: p.data.pubDate || new Date('2026-01-01')
});

const singBoxPosts = allPosts.filter(p => p.data.tags && p.data.tags.includes('sing-box')).map(formatPost);

const singBoxFaqs = [
  { q: "sing-box 是什么？", a: "sing-box 是一款被誉为下一代通用代理平台的开源核心内核。它原生支持非常多现代协议（如 VLESS、Hysteria 2、TUIC、Reality），并且由于使用 Go 编写，性能优异，在全平台都有非常好的表现。" },
  { q: "sing-box 怎么用？", a: "可以直接使用 sing-box 提供的各平台官方客户端，导入机场提供的 sing-box 格式订阅即可。配置一般为 JSON 格式。" },
  { q: "sing-box 和 Clash 哪个好？", a: "sing-box 支持更多前沿协议，占用更小，更适合追求极致性能与新协议的用户。而 Clash 的生态更庞大，GUI 客户端更多，策略组功能更成熟。" },
  { q: "如何获取 sing-box 节点？", a: "现在很多主流机场都已经开始原生支持提供 sing-box 的 JSON 订阅链接，你也可以使用订阅转换工具将普通节点转换为 sing-box 格式。" }
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "首页", "item": "https://www.clashwiki.blog/" },
    { "@type": "ListItem", "position": 2, "name": "专题", "item": "https://www.clashwiki.blog/topics/" },
    { "@type": "ListItem", "position": 3, "name": "sing-box 指南", "item": "https://www.clashwiki.blog/tag/sing-box/" }
  ]
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": singBoxFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.q,
    "acceptedAnswer": { "@type": "Answer", "text": faq.a }
  }))
};
---

<BaseLayout 
  title="sing-box 教程与配置指南｜协议、订阅与常见问题 - ClashWiki" 
  description="深度解析下一代代理工具 sing-box，提供详尽的教程、配置、协议支持说明及最新机场节点推荐。" 
  keywords="sing-box,sing-box教程,sing-box配置,sing-box客户端,sing-box协议,sing-box排障,sing-box节点,机场推荐"
>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="container mx-auto max-w-7xl px-4 pt-28 pb-10">
    <Breadcrumb items={[{ label: '专题', href: '/topics/' }, { label: 'sing-box 指南' }]} />
    
    <div class="mt-8 mb-16 relative bg-slate-900 border border-slate-800 rounded-3xl p-10 overflow-hidden shadow-2xl">
      <div class="absolute -right-20 -top-20 w-64 h-64 bg-cyan-500/10 rounded-full blur-3xl"></div>
      <div class="relative z-10 max-w-3xl">
        <h1 class="text-3xl md:text-5xl font-heading font-black text-slate-100 mb-6 leading-tight">
          关于 <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">sing-box</span> 的深度指南
        </h1>
        <p class="text-xl text-slate-300 font-medium mb-4 leading-relaxed">
          全平台通用的下一代网络代理平台核心。
        </p>
      </div>
    </div>

    <PageQuickRead />

    <div class="mb-20" id="all-articles">
      <div class="flex items-center gap-3 mb-8 pb-4 border-b border-slate-800">
        <h2 class="text-3xl font-heading font-bold text-slate-100">所有 sing-box 教程与文章</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {singBoxPosts.map(post => <ArticleCard {...post} />)}
      </div>
    </div>

    <div class="mb-20 scroll-mt-48" id="faq">
      <div class="flex items-center gap-3 mb-8 pb-4 border-b border-slate-800">
        <h2 class="text-3xl font-heading font-bold text-slate-100">热门 sing-box 问题解答</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {singBoxFaqs.map(faq => (
          <div class="p-6 bg-slate-900 border border-slate-800 rounded-2xl hover:border-cyan-500/30 transition-colors">
            <h3 class="text-slate-100 font-bold mb-3 leading-snug">{faq.q}</h3>
            <p class="text-slate-400 text-sm leading-relaxed">
              {faq.a} 
              <a href="/tag/sing-box/" class="text-cyan-400 ml-1 hover:underline">查看完整教程 &rarr;</a>
            </p>
          </div>
        ))}
      </div>
    </div>

    <HubFooterLinks />
  </div>
</BaseLayout>
